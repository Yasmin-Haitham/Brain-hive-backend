# Copy this file to server/.env and fill in real values. Never commit server/.env.

# MongoDB connection string (e.g. from MongoDB Atlas)
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/<db>

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contentful (course content)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# Google API key sent to the browser for course pages — restrict it by HTTP referrer in Google Cloud Console
GOOGLE_API_KEY=

PORT=3030
